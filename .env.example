# Copy this file to .env and replace the placeholder password.
ConnectionStrings__InstiDb="Server=localhost,1433;Database=instituto_db;User Id=sa;Password=REPLACE_ME;TrustServerCertificate=True;"

# Clave HMAC para firmar los access tokens (mínimo 32 bytes). Obligatoria fuera de Development.
# Generar con: openssl rand -base64 48
Jwt__Secret="REPLACE_ME_WITH_A_LONG_RANDOM_SECRET"
