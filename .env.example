# Copy this file to .env and replace the placeholders.

# --- docker compose (SQL Server + API + Web) ---
# Contraseña de sa: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD="REPLACE_ME"
MSSQL_DATABASE="instituto_db"
MSSQL_PID="Express"
TZ="America/Argentina/Buenos_Aires"

# Clave HMAC para firmar los access tokens (mínimo 32 bytes). Obligatoria fuera de Development.
# Generar con: openssl rand -base64 48
Jwt__Secret="REPLACE_ME_WITH_A_LONG_RANDOM_SECRET"

# --- ejecución local con dotnet run / start-dev.sh (sin docker) ---
ConnectionStrings__InstiDb="Server=localhost,1433;Database=instituto_db;User Id=sa;Password=REPLACE_ME;TrustServerCertificate=True;"
