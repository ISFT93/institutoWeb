# Copiar a deploy/.env y reemplazar los valores REPLACE_ME.

# --- Obligatorias ---

# Contraseña del usuario sa de SQL Server (mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos).
MSSQL_SA_PASSWORD="REPLACE_ME"

# Clave HMAC para firmar los access tokens (mínimo 32 bytes). Generar con: openssl rand -base64 48
Jwt__Secret="REPLACE_ME_WITH_A_LONG_RANDOM_SECRET"

# --- Opcionales (valores por defecto) ---

# Los scripts de deploy/scripts/base usan "instituto_db"; cambiarlo solo si los scripts también cambian.
MSSQL_DATABASE="instituto_db"
MSSQL_PID="Express"
TZ="America/Argentina/Buenos_Aires"

# Production (por defecto): sin seed de usuarios de prueba y la cookie exige HTTPS.
# Development: ejecuta el seed (DNI 99999999 y 88888888, password PruebaInstituto93!).
ASPNETCORE_ENVIRONMENT="Production"
