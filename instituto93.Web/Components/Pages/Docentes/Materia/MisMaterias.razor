@page "/docentes/materias"
@attribute [Authorize(Roles = "Docente")]
@inject DocenteMateriasApiClient Api
@inject NavigationManager Navigation
@using instituto93.Web.Models
@using instituto93.Web.Services

<PageTitle>Mis materias</PageTitle>

<main class="materias-page">
    <div class="materias-container">
        <header>
            <span>Docentes</span>
            <h1>Mis materias</h1>
            <p>Consultá las materias que tenés asignadas y gestioná sus evaluaciones.</p>
        </header>

        @if (_loading)
        {
            <section class="state" aria-live="polite">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <div><strong>Cargando materias</strong><p>Estamos buscando tus materias asignadas.</p></div>
            </section>
        }
        else if (_error is not null)
        {
            <section class="state error" role="alert">
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
                <div><strong>No pudimos cargar tus materias</strong><p>@_error</p></div>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="LoadAsync">Reintentar</MudButton>
            </section>
        }
        else
        {
            <section class="filters-panel" aria-label="Filtros de materias">
                <div class="filter-search">
                    <MudTextField T="string"
                                @bind-Value="_search"
                                Immediate="true"
                                Placeholder="Buscar materia o curso..."
                                Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.Search"
                                Variant="Variant.Outlined"
                                aria-label="Buscar materias" />
                </div>

                <div class="filter-select">
                    <MudSelect T="string"
                            @bind-Value="_carrera"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.School"
                            Variant="Variant.Outlined"
                            aria-label="Filtrar por carrera">
                        <MudSelectItem Value="@Todos">Todas las carreras</MudSelectItem>
                        @foreach (var carrera in Carreras)
                        {
                            <MudSelectItem Value="@carrera">@carrera</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-select">
                    <MudSelect T="string"
                            @bind-Value="_anioLectivo"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                            Variant="Variant.Outlined"
                            aria-label="Filtrar por ciclo lectivo">
                        <MudSelectItem Value="@Todos">Todos los ciclos</MudSelectItem>
                        @foreach (var anio in AniosLectivos)
                        {
                            <MudSelectItem Value="@anio">@anio</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </section>

            @if (!Filtered.Any())
            {
                <section class="state">
                    <MudIcon Icon="@Icons.Material.Outlined.MenuBook" />
                    <div>
                        <strong>No hay materias para mostrar</strong>
                        <p>@(_items.Count == 0 ? "Todavía no tenés materias asignadas." : "Probá cambiando la búsqueda o los filtros.")</p>
                    </div>
                    @if (_items.Count > 0)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="LimpiarFiltros">
                            Limpiar filtros
                        </MudButton>
                    }
                </section>
            }
            else
            {
                <section class="cards" aria-label="Materias asignadas">
                    @foreach (var item in Filtered)
                    {
                        <article class="card">
                            <div>
                                <small>@item.Carrera</small>
                                <h2>@item.Materia</h2>
                                <p>@item.Curso · @item.AnioLectivo</p>
                            </div>
                            <div class="metrics">
                                <span><b>@item.CantidadEstudiantes</b> estudiantes</span>
                                <span><b>@item.CantidadEvaluaciones</b> evaluaciones</span>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Open(item.CursadaId))">
                                Ver materia
                            </MudButton>
                        </article>
                    }
                </section>
            }
        }
    </div>
</main>

@code {
    private const string Todos = "Todos";
    private List<MateriaDocenteModel> _items = [];
    private bool _loading = true;
    private string? _error;
    private string? _search;
    private string _carrera = Todos;
    private string _anioLectivo = Todos;

    private IEnumerable<string> Carreras => _items
        .Select(item => item.Carrera)
        .Where(carrera => !string.IsNullOrWhiteSpace(carrera))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(carrera => carrera);

    private IEnumerable<string> AniosLectivos => _items
        .Select(item => item.AnioLectivo.ToString())
        .Distinct()
        .OrderDescending();

    private IEnumerable<MateriaDocenteModel> Filtered => _items.Where(item =>
        (string.IsNullOrWhiteSpace(_search) ||
        item.Materia.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        item.Carrera.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        item.Curso.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (_carrera == Todos || item.Carrera.Equals(_carrera, StringComparison.OrdinalIgnoreCase)) &&
        (_anioLectivo == Todos || item.AnioLectivo.ToString() == _anioLectivo));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.GetAsync();
            _items = result.Data;
            _error = result.Error;
        }
        finally
        {
            _loading = false;
        }
    }

    private void LimpiarFiltros()
    {
        _search = null;
        _carrera = Todos;
        _anioLectivo = Todos;
    }

    private void Open(int id) => Navigation.NavigateTo($"/docentes/materias/{id}");
}
