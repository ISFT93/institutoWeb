@page "/docentes/materias/{CursadaId:int}/evaluaciones"
@attribute [Authorize(Roles="Docente")]
@inject DocenteMateriasApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using instituto93.Web.Models
@using instituto93.Web.Services

<PageTitle>Evaluaciones</PageTitle>

<main class="materias-page">
    <div class="materias-container">
        <MudButton Variant="Variant.Text"
                Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.ArrowBack"
                Class="back-button"
                OnClick="Back">
            Volver a la materia
        </MudButton>

        <header class="page-header">
            <h1>Evaluaciones</h1>
            <p>Creá evaluaciones y administrá la carga de notas.</p>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="New">Nueva evaluación</MudButton>
        </header>

        @if (_error is not null)
        {
            <section class="error" role="alert">
                <span>@_error</span>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Reload">Reintentar</MudButton>
            </section>
        }

        @if (_editing)
        {
            <section class="card form">
                <h2>@(_id is null ? "Nueva evaluación" : "Editar evaluación")</h2>

                <MudSelect T="int" @bind-Value="_type" Label="Tipo" Variant="Variant.Outlined">
                    @foreach (var t in _types)
                    {
                        <MudSelectItem Value="@t.TipoEvaluacionId">@t.Descripcion</MudSelectItem>
                    }
                </MudSelect>

                <MudTextField @bind-Value="_name" Label="Nombre" Variant="Variant.Outlined" Required="true" />

                <MudDatePicker @bind-Date="_date"
                            Label="Fecha"
                            Variant="Variant.Outlined"
                            Editable="true"
                            DateFormat="dd/MM/yyyy"
                            MinDate="@(_id is null ? _minDate : (DateTime?)null)" />

                <MudSelect T="byte" @bind-Value="_term" Label="Cuatrimestre" Variant="Variant.Outlined">
                    <MudSelectItem T="byte" Value="1">1°</MudSelectItem>
                    <MudSelectItem T="byte" Value="2">2°</MudSelectItem>
                </MudSelect>

                @if (_id is not null)
                {
                    <MudSelect T="string" @bind-Value="_state" Label="Estado" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Borrador")">Borrador</MudSelectItem>
                        <MudSelectItem Value="@("Activa")">Activa</MudSelectItem>
                        <MudSelectItem Value="@("Cerrada")">Cerrada</MudSelectItem>
                    </MudSelect>
                }

                <div class="form-actions">
                    <MudButton Disabled="_saving" OnClick="Save" Variant="Variant.Filled" Color="Color.Primary">
                        @(_saving ? "Guardando…" : "Guardar")
                    </MudButton>
                    <MudButton OnClick="Cancel">Cancelar</MudButton>
                </div>
            </section>
        }

        @if (!_loading && _items.Count > 0)
        {
            <div class="search-row">
                <MudTextField T="string"
                            @bind-Value="_search"
                            Immediate="true"
                            Placeholder="Buscar evaluación por nombre, tipo o estado..."
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Search"
                            Variant="Variant.Outlined"
                            aria-label="Buscar evaluaciones" />
            </div>
        }

        @if (_loading)
        {
            <section class="state" aria-live="polite">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <div><strong>Cargando evaluaciones</strong><span>Estamos preparando las evaluaciones de la materia.</span></div>
            </section>
        }
        else if (_items.Count == 0 && _error is null)
        {
            <section class="state">
                <MudIcon Icon="@Icons.Material.Outlined.Assignment" />
                <div><strong>Todavía no hay evaluaciones</strong><span>Creá la primera evaluación para comenzar la carga de notas.</span></div>
            </section>
        }
        else if (_items.Count > 0 && !FilteredEvaluations.Any())
        {
            <section class="state filter-empty">
                <MudIcon Icon="@Icons.Material.Outlined.SearchOff" />
                <div><strong>No encontramos evaluaciones</strong><span>Probá con otra búsqueda.</span></div>
            </section>
        }
        else if (_items.Count > 0)
        {
            <section class="cards">
                @foreach (var e in FilteredEvaluations)
                {
                    <article class="card">
                        <div class="title">
                            <div>
                                <span class="badge @e.Estado.ToLowerInvariant()">@e.Estado</span>
                                <h2>@e.Nombre</h2>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => Edit(e))" />
                        </div>
                        <p>@e.Tipo · @e.Fecha.ToString("dd/MM/yyyy") · @e.Cuatrimestre° cuatrimestre</p>
                        <p><strong>@e.NotasCargadas</strong> de @e.CantidadEstudiantes notas</p>
                        <MudProgressLinear Value="@(e.CantidadEstudiantes == 0 ? 0 : 100d * e.NotasCargadas / e.CantidadEstudiantes)" />
                        <MudButton Disabled="@(e.Estado == "Borrador")" OnClick="@(() => Open(e.EvaluacionId))">
                            @NotesAction(e)
                        </MudButton>
                    </article>
                }
            </section>
        }
    </div>
</main>

@code {
    [Parameter]
    public int CursadaId { get; set; }

    private readonly DateTime _minDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<EvaluacionDocenteModel> _items = [];
    private List<TipoEvaluacionModel> _types = [];
    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private string? _error;
    private string? _search;
    private int? _id;
    private int _type;
    private string _name = "";
    private string _state = "Borrador";
    private string _version = "";
    private DateTime? _date = DateTime.Today;
    private byte _term = 1;
    private decimal? _weight;

    private IEnumerable<EvaluacionDocenteModel> FilteredEvaluations =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(e =>
                e.Nombre.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                e.Tipo.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                e.Estado.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => Reload();

    private async Task Reload()
    {
        _loading = true;
        _error = null;
        try
        {
            if (_types.Count == 0)
            {
                _types = await Api.GetTiposAsync();
                _type = _types.FirstOrDefault()?.TipoEvaluacionId ?? 0;
            }
            await Load();
        }
        catch
        {
            _error = "No se pudieron cargar las evaluaciones.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Load() => _items = await Api.GetEvaluacionesAsync(CursadaId);

    private void New()
    {
        _id = null;
        _type = _types.FirstOrDefault()?.TipoEvaluacionId ?? 0;
        _name = "";
        _date = DateTime.Today;
        _term = 1;
        _weight = null;
        _state = "Borrador";
        _editing = true;
    }

    private void Edit(EvaluacionDocenteModel e)
    {
        _id = e.EvaluacionId;
        _type = e.TipoEvaluacionId;
        _name = e.Nombre;
        _date = e.Fecha;
        _term = e.Cuatrimestre;
        _weight = e.Ponderacion;
        _state = e.Estado;
        _version = e.Version;
        _editing = true;
    }

    private void Cancel() => _editing = false;

    private async Task Save()
    {
        if (_type <= 0)
        {
            _error = "Seleccioná un tipo de evaluación.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Ingresá un nombre.";
            return;
        }
        if (_id is null && _date < _minDate)
        {
            _error = "La fecha debe pertenecer al mes actual o a uno posterior.";
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            if (_id is null)
                await Api.CrearAsync(CursadaId, new(_type, _name, _date ?? DateTime.Today, _term));
            else
                await Api.ActualizarAsync(_id.Value, new(_type, _name, _date ?? DateTime.Today, _term, _state, _weight, _version));

            _editing = false;
            await Load();
            Snackbar.Add("Evaluación guardada", Severity.Success);
        }
        catch
        {
            _error = "No se pudo guardar. Recargá la página e intentá nuevamente.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string NotesAction(EvaluacionDocenteModel evaluation) => evaluation.Estado switch
    {
        "Cerrada" => "Mirar notas",
        "Borrador" => "Activá para cargar notas",
        _ => "Cargar notas"
    };

    private void Back() => Nav.NavigateTo($"/docentes/materias/{CursadaId}");

    private void Open(int id) => Nav.NavigateTo($"/docentes/materias/evaluaciones/{id}/notas");
}
