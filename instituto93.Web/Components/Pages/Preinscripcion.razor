    private void HandleInvalidSubmit(EditContext editContext)
    {
        _submitSuccess = null;

        _submitError =
            "No se pudo enviar la preinscripción porque hay campos obligatorios o datos inválidos. Revisá el formulario.";
    }

    private async Task HandleSubmit()
    {
        if (_sending)
            return;

        _sending = true;

        _submitSuccess = null;
        _submitError = null;

        try
        {
            var result =
                await PreinscripcionApi.CreateAsync(
                    _model);

            if (!result.IsSuccess)
            {
                _submitError = result.Error;

                return;
            }

            _submitSuccess =
                result.AlumnoId is { } alumnoId
                    ? $"Preinscripción guardada correctamente. AlumnoId: {alumnoId}"
                    : "Preinscripción guardada correctamente.";

            _model =
                new PreinscripcionModel();
        }
        catch (HttpRequestException ex)
        {
            _submitError =
                "No se pudo conectar con instituto93.Controller. " +
                "Verificá que la API esté iniciada. " +
                ex.Message;
        }
        catch (Exception ex)
        {
            _submitError =
                "Se produjo un error al guardar la preinscripción: " +
                ex.Message;
        }
        finally
        {
            _sending = false;
        }
    }



