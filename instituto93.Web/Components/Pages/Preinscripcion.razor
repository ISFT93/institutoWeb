@page "/preinscripcion"

@inject PreinscripcionApiClient PreinscripcionApi
@inject CarrerasApiClient CarrerasApi
@using instituto93.Web.Models;
@using instituto93.Web.Components.Shared
@using instituto93.Web.Services

<PageTitle>Preinscripción</PageTitle>

<main class="preinscripcion-page">

    <Navbar />

    <section class="preinscripcion-body">

        <header class="preinscripcion-intro">
            <h1>Preinscripción de alumnos</h1>
            <p>
                Completá tus datos para comenzar el trámite de inscripción.
                Los campos marcados con <strong>*</strong> son obligatorios.
            </p>
        </header>

    
        <EditForm Model="_model"
                  OnValidSubmit="HandleSubmit"
                  OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            @* <ValidationSummary /> *@

            <article class="form-section">
                <h2>Carrera de interés</h2>
                <div class="form-grid">
                    <MudSelect
                        T="int?"
                        Label="Carrera *"
                        @bind-Value="_model.CarreraId"
                        For="@(() => _model.CarreraId)"
                        Variant="Variant.Outlined"
                        Disabled="@(_carrerasLoading || _carrerasError is not null)"
                        Error="_carrerasError is not null"
                        ErrorText="@_carrerasError"
                        FullWidth>
                        @foreach (var carrera in _carreras)
                        {
                            <MudSelectItem T="int?" Value="@carrera.CarreraId">@carrera.Nombre</MudSelectItem>
                        }
                    </MudSelect>

                    @if (_carrerasLoading)
                    {
                        <div class="carreras-estado">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                            <span>Cargando carreras...</span>
                        </div>
                    }

                    @if (_carrerasError is not null)
                    {
                        <div class="carreras-estado">
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" />
                            <span>No se pudieron cargar las carreras desde la base de datos.</span>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="CargarCarrerasAsync">
                                Reintentar
                            </MudButton>
                        </div>
                    }
                </div>
            </article>

            <article class="form-section">
                <h2>Datos personales</h2>
                <div class="form-grid">

                    <MudTextField
                        Label="Nombre *"
                        @bind-Value="_model.Nombre"
                        For="@(() => _model.Nombre)"
                        Variant="Variant.Outlined"
                        MaxLength="50"
                        FullWidth/>

                    <MudTextField 
                        Label="Apellido *"
                        @bind-Value="_model.Apellido"
                        For="@(() => _model.Apellido)"
                        Variant="Variant.Outlined"
                        MaxLength="50"
                        FullWidth/>

                    <MudSelect
                        Label="Tipo de documento *"
                        @bind-Value="_model.TipoDocumento"
                        For="@(() => _model.TipoDocumento)"
                        Variant="Variant.Outlined"
                        MaxLength="10"
                        FullWidth>
                        @foreach (var tipo in _tiposDocumento)
                        {
                            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField
                        Label="Número de documento *"
                        @bind-Value="_model.NumeroDocumento"
                        For="@(() => _model.NumeroDocumento)"
                        Variant="Variant.Outlined"
                        MaxLength="8"
                        FullWidth
                        HideSpinButtons />
                    


                    <MudDatePicker
                        Label="Fecha de nacimiento *"
                        @bind-Date="_model.FechaNacimiento"
                        For="@(() => _model.FechaNacimiento)"
                        Variant="Variant.Outlined"
                        DateFormat="dd/MM/yyyy" />                    

                    <MudSelect
                        Label="Sexo *"
                        @bind-Value="_model.Sexo"
                        For="@(() => _model.Sexo)"
                        Variant="Variant.Outlined"
                        FullWidth>

                        @foreach (var sexo in _sexos)
                        {
                            <MudSelectItem Value="@sexo.Codigo">
                                @sexo.Descripcion
                            </MudSelectItem>
                        }
                    </MudSelect>

                </div>
            </article>

            <article class="form-section">
                <h2>Domicilio</h2>
                <div class="form-grid">
                    <MudTextField
                        Label="Calle *"
                        @bind-Value="_model.Calle"
                        For="@(() => _model.Calle)"
                        Variant="Variant.Outlined"
                        MaxLength="255"
                        FullWidth />
                                     
                    <MudTextField 
                        Label="Localidad *"
                        @bind-Value="_model.Localidad"
                        For="@(() => _model.Localidad)"
                        Variant="Variant.Outlined"
                        MaxLength="50"
                        FullWidth />

                </div>
            </article>

            <article class="form-section">
                <h2>Contacto</h2>
                <div class="form-grid">
                    <MudTextField
                        Label="Correo electrónico *"
                        @bind-Value="_model.Email"
                        For="@(() => _model.Email)"
                        Variant="Variant.Outlined"
                        MaxLength="255"
                        FullWidth />


                    <MudNumericField
                        Label="Teléfono fijo *"
                        @bind-Value="_model.Telefono"
                        For="@(() => _model.Telefono)"
                        Variant="Variant.Outlined"
                        MaxLength="30"
                        FullWidth
                        HideSpinButtons />

                    
                </div>
            </article>

            <article class="form-section">
                <h2>Formación</h2>
              

            </article>


            

                         
            @if (!string.IsNullOrWhiteSpace(_submitSuccess))
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Outlined"
                          Class="mb-3">

                    @_submitSuccess

                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(_submitError))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined"
                          Class="mb-3">

                    @_submitError

                </MudAlert>
            }
            
            <MudButton
                
              ButtonType="ButtonType.Submit"
              Variant="Variant.Filled"
              Color="Color.Primary"
              Size="Size.Large"
              Disabled="_sending"
              FullWidth>

              @(
              _sending
              ? "Guardando..."
              : "Enviar preinscripción"
              )
                
            </MudButton>

        </EditForm>

    </section>

</main>

