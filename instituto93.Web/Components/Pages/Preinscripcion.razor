@page "/preinscripcion"

@inject PreinscripcionApiClient PreinscripcionApi
@inject CarrerasApiClient CarrerasApi
@using instituto93.Web.Models;
@using instituto93.Web.Components.Shared
@using instituto93.Web.Services

<PageTitle>Preinscripción</PageTitle>

<main class="preinscripcion-page">

    <Navbar />

    <section class="preinscripcion-body">

        <header class="preinscripcion-intro">
            <h1>Preinscripción de alumnos</h1>
            <p>
                Completá tus datos para comenzar el trámite de inscripción.
                Los campos marcados con <strong>*</strong> son obligatorios.
            </p>
        </header>

    
        <EditForm Model="_model"
                  OnValidSubmit="HandleSubmit"
                  OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <article class="form-section">
                <h2>Carrera de interés</h2>
                <div class="form-grid">
                    <MudSelect
                        T="int?"
                        Label="Carrera *"
                        @bind-Value="_model.CarreraId"
                        Variant="Variant.Outlined"
                        Disabled="@(_carrerasLoading || _carrerasError is not null)"
                        Error="_carrerasError is not null"
                        ErrorText="@_carrerasError"
                        FullWidth>
                        @foreach (var carrera in _carreras)
                        {
                            <MudSelectItem T="int?" Value="@carrera.CarreraId">@carrera.Nombre</MudSelectItem>
                        }
                    </MudSelect>

                    @if (_carrerasLoading)
                    {
                        <div class="carreras-estado">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                            <span>Cargando carreras...</span>
                        </div>
                    }

                    @if (_carrerasError is not null)
                    {
                        <div class="carreras-estado">
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" />
                            <span>No se pudieron cargar las carreras desde la base de datos.</span>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="CargarCarrerasAsync">
                                Reintentar
                            </MudButton>
                        </div>
                    }
                </div>
            </article>

            <article class="form-section">
                <h2>Datos personales</h2>
                <div class="form-grid">

                    <MudTextField
                        Label="Nombre *"
                        @bind-Value="_model.Nombre"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField
                        Label="Apellido *"
                        @bind-Value="_model.Apellido"
                        Variant="Variant.Outlined"
                        FullWidth />                    

                    <MudSelect
                        Label="Tipo de documento *"
                        @bind-Value="_model.TipoDocumento"
                        Variant="Variant.Outlined"
                        FullWidth>
                        @foreach (var tipo in _tiposDocumento)
                        {
                            <MudSelectItem Value="@tipo">@tipo</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField
                        Label="Número de documento *"
                        @bind-Value="_model.NumeroDocumento"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudSelect
                        Label="Pais de nacimiento *"
                        @bind-Value="_model.PaisNacimiento"
                        Variant="Variant.Outlined"
                        FullWidth>
                        @foreach (var paises in _paises)
                        {
                            <MudSelectItem Value="@paises">@paises</MudSelectItem>
                        }
                    </MudSelect>

                     <MudTextField
                        Label="Localidad de nacimiento *"
                        @bind-Value="_model.LocalidadNacimiento"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudDatePicker
                        Label="Fecha de nacimiento *"
                        @bind-Date="_model.FechaNacimiento"
                        Variant="Variant.Outlined"
                        DateFormat="dd/MM/yyyy" />                    

                    <MudSelect
                        Label="Sexo *"
                        @bind-Value="_model.Sexo"
                        Variant="Variant.Outlined"
                        FullWidth>

                        @foreach (var sexo in _sexos)
                        {
                            <MudSelectItem Value="@sexo.Codigo">
                                @sexo.Descripcion
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect
                        Label="Estado civil"
                        @bind-Value="_model.EstadoCivil"
                        Variant="Variant.Outlined"
                        FullWidth>
                        @foreach (var estado in _estadosCiviles)
                        {
                            <MudSelectItem Value="@estado">@estado</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </article>

            <article class="form-section">
                <h2>Domicilio</h2>
                <div class="form-grid">
                    <MudTextField
                        Label="Calle *"
                        @bind-Value="_model.Calle"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField
                        Label="Número"
                        @bind-Value="_model.Numero"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField
                        Label="Piso"
                        @bind-Value="_model.Piso"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField
                        Label="Departamento"
                        @bind-Value="_model.Departamento"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField 
                        Label="Distrito *"
                        @bind-Value="_model.Distrito"
                        Variant="Variant.Outlined"
                        FullWidth/>

                    <MudSelect
                        Label="Provincia *"
                        @bind-Value="_model.Provincia"
                        Variant="Variant.Outlined"
                        FullWidth>

                        @foreach (var provincia in _provincias)
                        {
                        <MudSelectItem Value="@provincia">
                        @provincia
                       </MudSelectItem>
                       }
                    </MudSelect>
                                     
                    <MudTextField
                        Label="Localidad"
                        @bind-Value="_model.Localidad"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField
                        Label="Código postal"
                        @bind-Value="_model.CodigoPostal"
                        Variant="Variant.Outlined"
                        FullWidth />
                </div>
            </article>

            <article class="form-section">
                <h2>Contacto</h2>
                <div class="form-grid">
                    <MudTextField
                        Label="Correo electrónico *"
                        @bind-Value="_model.Email"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField
                        Label="Celular"
                        @bind-Value="_model.Celular"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField
                        Label="Teléfono fijo"
                        @bind-Value="_model.Telefono"
                        Variant="Variant.Outlined"
                        FullWidth />

                    
                </div>
            </article>

            <article class="form-section">
                <h2>Formación</h2>

                <div class="form-radios">
                    <h3>Título Secundario</h3>
                    <MudRadioGroup T="bool" @bind-Value="_model.TituloSecundario" @bind-Value:after="TituloChanged">
                        <MudRadio T="bool" Value="@true">Si</MudRadio>
                        <MudRadio T="bool" Value="@false">No</MudRadio>
                    </MudRadioGroup>
                </div>                 

                <div class="form-grid">

                    @if (!_model.TituloSecundario)
                    {
                        <MudNumericField Label="Cantidad de materias adeudadas"
                                         T="int?"
                                         @bind-Value="_model.CantidadAdeudaMaterias"
                                         Variant="Variant.Outlined"
                                         Min="0"
                                         Max="20"
                                         Disabled="_model.TituloSecundario"
                                         FullWidth />

                        <MudTextField Label="Descripción de materias adeudadas"
                                      @bind-Value="_model.DescripcionMaterias"
                                      Variant="Variant.Outlined"
                                      Disabled="_model.TituloSecundario"
                                      Lines="3"
                                      FullWidth />
                    }

                    @if(_model.TituloSecundario)
                    {
                       
                        <MudTextField Label="Título"
                                      @bind-Value="_model.Titulo"
                                      Variant="Variant.Outlined"
                                      Disabled="!_model.TituloSecundario"
                                      FullWidth />

                        <MudTextField Label="Orientación"
                                      @bind-Value="_model.Orientacion"
                                      Variant="Variant.Outlined"
                                      Disabled="!_model.TituloSecundario"
                                      FullWidth />

                        <MudTextField Label="Institución que lo otorgó"
                                      @bind-Value="_model.OtorgadoPor"
                                      Variant="Variant.Outlined"
                                      Disabled="!_model.TituloSecundario"
                                      FullWidth />

                        <MudNumericField Label="Año de egreso"
                                         T="int?"
                                         @bind-Value="_model.AnioEgreso"
                                         Variant="Variant.Outlined"
                                         Disabled="!_model.TituloSecundario"
                                         Min="1900"
                                         Max="@DateTime.Now.Year"
                                         FullWidth />

                        <MudNumericField Label="Promedio"
                                         T="decimal?"
                                         @bind-Value="_model.Promedio"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="10"
                                         Disabled="!_model.TituloSecundario"
                                         FullWidth />

                        <div class="form-radios">
                            <h3>Título en Trámite</h3>
                            <MudRadioGroup T="bool" @bind-Value="_model.TituloTramite" Disabled="!_model.TituloSecundario">
                                <MudRadio T="bool" Value="@true">Si</MudRadio>
                                <MudRadio T="bool" Value="@false">No</MudRadio>
                            </MudRadioGroup>
                        </div>

                        <MudSelect Label="Mayor título *"
                                   @bind-Value="_model.MayorTitulo"
                                   Variant="Variant.Outlined"
                                   @bind-Value:after="OnMayorTituloChanged"
                                   Disabled="!_model.TituloSecundario"
                                   FullWidth>
                            @foreach (var mayorTitulo in _mayorTitulo)
                            {
                                <MudSelectItem Value="@mayorTitulo">@mayorTitulo</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTextField Label="Otro título"
                                      @bind-Value="_model.OtroTitulo"
                                      Disabled="@(_model.MayorTitulo == "Ninguno")"
                                      Variant="Variant.Outlined"
                                      FullWidth />

                        <MudTextField Label="Institución que otorgó el mayor título"
                                      @bind-Value="_model.MayorOtorgadoPor"
                                      Disabled="@(_model.MayorTitulo == "Ninguno")"
                                      Variant="Variant.Outlined"
                                      FullWidth />

                        <MudNumericField Label="Mayor promedio"
                                         T="decimal?"
                                         @bind-Value="_model.MayorPromedio"
                                         Min="1"
                                         Max="10"
                                         Disabled="@(_model.MayorTitulo == "Ninguno")"
                                         Variant="Variant.Outlined"
                                         FullWidth />
                    }
                    
                    

                    
                </div>
            </article>

            @* Esta sección actualmente esta oculta. Modificar la propiedad display del selector de clase .documentos para hacerla visible*@
            <article class="form-section documentos">
                <h2>Documentación a presentar</h2>

                <div class="documentos-grid">
                    <div class="documento-upload">
                        <span class="documento-upload-label">Fotocopia del título</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.FotocopiaTitulo"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsDocumento"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                    </div>

                    <div class="documento-upload">
                        <span class="documento-upload-label">Constancia de título en trámite</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.ConstanciaTituloTramite"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsDocumento"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                    </div>

                    <div class="documento-upload">
                        <span class="documento-upload-label">Constancia de materias adeudadas</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.ConstanciaAdeudaMaterias"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsDocumento"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                    </div>

                    <div class="documento-upload">
                        <span class="documento-upload-label">Certificado de aptitud</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.CertificadoAptitud"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsDocumento"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                    </div>

                    <div class="documento-upload">
                        <span class="documento-upload-label">Fotocopia del documento</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.FotocopiaDocumento"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsDocumento"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                    </div>

                    <div class="documento-upload">
                        <span class="documento-upload-label">Foto carnet</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.FotoCarnet"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsImagen"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">JPG o PNG · máx. 5 MB</span>
                    </div>

                    <div class="documento-upload">
                        <span class="documento-upload-label">Fotocopia de partida de nacimiento</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.FotocopiaPartidaNacimiento"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsDocumento"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                    </div>

                    <div class="documento-upload">
                        <span class="documento-upload-label">Vacuna antihepatitis</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.VacunaAntihepatitis"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsDocumento"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                    </div>

                    <div class="documento-upload">
                        <span class="documento-upload-label">Vacuna antitetánica</span>
                        <MudFileUpload
                            T="IBrowserFile"
                            @bind-Files="_model.VacunaAntitetanica"
                            MaxFileSize="@_maxFileSizeBytes"
                            Accept="@_formatsDocumento"
                            DragAndDrop="true" />
                        <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                    </div>
                </div>
            </article>

            <article class="form-section">
                <h2>Salud</h2>

                <div class="salud-fila">
                    <MudCheckBox
                        T="bool"
                        @bind-Value="_model.ObraSocialPrepaga"
                        Label="Poseo obra social / prepaga" />
                    <MudTextField
                        Label="Obra social / prepaga"
                        @bind-Value="_model.DescripcionObraSocial"
                        Variant="Variant.Outlined"
                        FullWidth
                        Disabled="!_model.ObraSocialPrepaga" />
                </div>

                <div class="salud-fila">
                    <MudCheckBox
                        T="bool"
                        @bind-Value="_model.TratamientoMedico"
                        Label="Me encuentro en tratamiento médico" />
                    <MudTextField
                        Label="Descripción del tratamiento"
                        @bind-Value="_model.DescripcionTratamiento"
                        Variant="Variant.Outlined"
                        FullWidth
                        Disabled="!_model.TratamientoMedico" />
                </div>

                <div class="salud-fila">
                    <MudCheckBox
                        T="bool"
                        @bind-Value="_model.Medicacion"
                        Label="Consumo medicación" />
                    <MudTextField
                        Label="Descripción de la medicación"
                        @bind-Value="_model.DescripcionMedicacion"
                        Variant="Variant.Outlined"
                        FullWidth
                        Disabled="!_model.Medicacion" />
                </div>

                <div class="salud-fila">
                    <MudCheckBox
                        T="bool"
                        @bind-Value="_model.Discapacidad"
                        Label="Presento discapacidad" />
                    <div class="salud-discapacidad">
                        <MudTextField
                            Label="Estado de discapacidad"
                            @bind-Value="_model.EstadoDiscapacidad"
                            Variant="Variant.Outlined"
                            FullWidth
                            Disabled="!_model.Discapacidad" />

                        <MudTextField
                            Label="Descripción de discapacidad"
                            @bind-Value="_model.DescripcionDiscapacidad"
                            Variant="Variant.Outlined"
                            FullWidth
                            Disabled="!_model.Discapacidad" />

                        <div class="documento-upload">
                            <span class="documento-upload-label">Certificado de discapacidad</span>
                            <MudFileUpload
                                T="IBrowserFile"
                                @bind-Files="_model.CertificadoDiscapacidad"
                                MaxFileSize="@_maxFileSizeBytes"
                                Accept="@_formatsDocumento"
                                DragAndDrop="true"
                                Disabled="!_model.Discapacidad" />
                            <span class="documento-upload-hint">PDF, JPG o PNG · máx. 5 MB</span>
                        </div>
                    </div>
                </div>

                <h3>En caso de emergencia:</h3>
                <div class="form-grid">
                    
                    <MudTextField
                        Label="Nombre del contacto de emergencia"
                        @bind-Value="_model.ContactoEmergencia"
                        Variant="Variant.Outlined"
                        FullWidth />

                    <MudTextField
                        Label="Teléfono del contacto de emergencia"
                        @bind-Value="_model.TelefonoContacto"
                        Variant="Variant.Outlined"
                        FullWidth />
                </div>
            </article>

                         
            @if (!string.IsNullOrWhiteSpace(_submitSuccess))
            {
                <MudAlert Severity="Severity.Success"
                          Variant="Variant.Outlined"
                          Class="mb-3">

                    @_submitSuccess

                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(_submitError))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined"
                          Class="mb-3">

                    @_submitError

                </MudAlert>
            }
            
            <MudButton
                
              ButtonType="ButtonType.Submit"
              Variant="Variant.Filled"
              Color="Color.Primary"
              Size="Size.Large"
              Disabled="_sending"
              FullWidth>

              @(
              _sending
              ? "Guardando..."
              : "Enviar preinscripción"
              )
                
            </MudButton>

        </EditForm>

    </section>

</main>

@code {
      
    private bool _sending = false;

    private string? _submitSuccess;

    private string? _submitError;

    private PreinscripcionModel _model = new PreinscripcionModel();

    private List<CarrerasLookupModel> _carreras = new();

    private bool _carrerasLoading = true;

    private string? _carrerasError;

    protected override async Task OnInitializedAsync()
    {
        await CargarCarrerasAsync();
    }

    private async Task CargarCarrerasAsync()
    {
        _carrerasLoading = true;
        _carrerasError = null;

        try
        {
            var result = await CarrerasApi.GetAsync();

            if (result.IsSuccess)
            {
                _carreras = result.Carreras;

                if (_carreras.Count == 0)
                    _carrerasError = "No hay carreras cargadas en la base de datos.";
            }
            else
            {
                _carreras = new();
                _carrerasError = result.Error;
            }
        }
        finally
        {
            _carrerasLoading = false;
        }
    }

