@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@using instituto93.Web.Auth
@using instituto93.Web.Models
@using instituto93.Web.Services
@inject AuthApiClient AuthApiClient

<PageTitle>Iniciar Sesión</PageTitle>

<main class="login-page">

    <section class="login-hero">
        <header class="institution">
            <img
                src="/images/logo.png"
                alt="Logo del Instituto Superior de Formación Técnica N° 93" />

            <div>
                <strong>
                    Instituto Superior de Formación Técnica N° 93
                </strong>

                <span>Portal académico</span>
            </div>
        </header>

        <div class="login-hero-content">
            <h1>
                Bienvenido/a al portal<br />
                web del instituto
            </h1>

            <p>
                Accedé a información, trámites y herramientas
                para acompañar tu experiencia institucional.
            </p>
        </div>
    </section>

    <section class="login-content">

        <article class="login-card">

            <header>
                <h2>@HeaderTitle</h2>

                <p>@HeaderText</p>
            </header>

            @* SSR estático: cada paso es un formulario HTML que se envía al servidor (POST) y vuelve a renderizar la página. *@
            @if (_step == LoginStep.Dni)
            {
                <EditForm Model="DniInput" FormName="dni" OnValidSubmit="HandleDni" method="post">
                    <DataAnnotationsValidator />

                    <div class="field dni-input">
                        <div class="field-control">
                            <InputText id="dni" @bind-Value="DniInput.Dni" placeholder="12.345.678" inputmode="numeric" autocomplete="off" />
                            <label for="dni">D.N.I</label>
                        </div>
                        <ValidationMessage For="() => DniInput.Dni" />
                    </div>

                    <button type="submit" class="btn btn-primary">Continuar</button>
                </EditForm>
            }
            else if (_step == LoginStep.Login)
            {
                <div class="field">
                    <div class="field-control">
                        <input id="dni-readonly" value="@FormatDni(LoginInput.Dni)" placeholder=" " readonly />
                        <label for="dni-readonly">D.N.I</label>
                    </div>
                </div>

                <EditForm Model="LoginInput" FormName="login" OnValidSubmit="HandleLogin" method="post">
                    <DataAnnotationsValidator />

                    <InputText type="hidden" @bind-Value="LoginInput.Dni" />

                    <div class="field">
                        <div class="field-control">
                            <InputText id="password" type="password" @bind-Value="LoginInput.Password" placeholder=" " autocomplete="current-password" />
                            <label for="password">Contraseña</label>
                        </div>
                        <ValidationMessage For="() => LoginInput.Password" />
                    </div>

                    <button type="submit" class="btn btn-primary">Ingresar</button>
                </EditForm>

                <a class="btn btn-text" href="@LoginHref">Volver</a>
            }
            else if (_step == LoginStep.CreatePassword)
            {
                <div class="field">
                    <div class="field-control">
                        <input id="dni-readonly" value="@FormatDni(CreatePasswordInput.Dni)" placeholder=" " readonly />
                        <label for="dni-readonly">D.N.I</label>
                    </div>
                </div>

                <EditForm Model="CreatePasswordInput" FormName="create-password" OnValidSubmit="HandleCreatePassword" method="post">
                    <DataAnnotationsValidator />

                    <InputText type="hidden" @bind-Value="CreatePasswordInput.Dni" />

                    <div class="field">
                        <div class="field-control">
                            <InputText id="new-password" type="password" @bind-Value="CreatePasswordInput.Password" placeholder=" " autocomplete="new-password" />
                            <label for="new-password">Nueva contraseña</label>
                        </div>
                        <small>Mínimo 8 caracteres.</small>
                        <ValidationMessage For="() => CreatePasswordInput.Password" />
                    </div>

                    <div class="field">
                        <div class="field-control">
                            <InputText id="confirm-password" type="password" @bind-Value="CreatePasswordInput.ConfirmPassword" placeholder=" " autocomplete="new-password" />
                            <label for="confirm-password">Confirmar contraseña</label>
                        </div>
                        <ValidationMessage For="() => CreatePasswordInput.ConfirmPassword" />
                    </div>

                    <button type="submit" class="btn btn-primary">Crear contraseña</button>
                </EditForm>

                <a class="btn btn-text" href="@LoginHref">Volver</a>
            }
            else
            {
                <div class="alert alert-success" role="status">
                    Tu contraseña se creó con éxito. Ya podés iniciar sesión.
                </div>

                <a class="btn btn-primary" href="@LoginHref">Ir a iniciar sesión</a>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="alert alert-error" role="alert">@_errorMessage</div>
            }

        </article>

    </section>

</main>

@code {
    private enum LoginStep
    {
        Dni,
        Login,
        CreatePassword,
        Success
    }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // Un formulario por paso. La propiedad se completa solo si se envió ese formulario; el
    // nombre ("Name") tiene que coincidir con el prefijo de los campos (DniInput.Dni, etc.).
    [SupplyParameterFromForm(Name = nameof(DniInput), FormName = "dni")]
    private DniModel? PostedDni { get; set; }

    [SupplyParameterFromForm(Name = nameof(LoginInput), FormName = "login")]
    private LoginModel? PostedLogin { get; set; }

    [SupplyParameterFromForm(Name = nameof(CreatePasswordInput), FormName = "create-password")]
    private CreatePasswordModel? PostedCreatePassword { get; set; }

    private LoginStep _step = LoginStep.Dni;
    private DniModel DniInput = new();
    private LoginModel LoginInput = new();
    private CreatePasswordModel CreatePasswordInput = new();
    private string? _errorMessage;

    private string LoginHref => Navigation.GetUriWithQueryParameters(
        "login",
        new Dictionary<string, object?> { ["returnUrl"] = ReturnUrl });

    private string HeaderTitle => _step switch
    {
        LoginStep.CreatePassword => "Creá tu contraseña",
        LoginStep.Success => "¡Listo!",
        _ => "Ingresá al portal"
    };

    private string HeaderText => _step switch
    {
        LoginStep.Dni => "Ingresá tu D.N.I para continuar.",
        LoginStep.Login => "Ingresá tu contraseña para acceder.",
        LoginStep.CreatePassword => "Es tu primer ingreso. Elegí una contraseña para tu cuenta.",
        _ => "Tu cuenta quedó configurada."
    };

    protected override void OnInitialized()
    {
        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(LoginRedirect.SanitizeReturnUrl(ReturnUrl));
            return;
        }

        if (PostedDni is not null)
        {
            DniInput = PostedDni;
        }
        else if (PostedLogin is not null)
        {
            LoginInput = PostedLogin;
            _step = LoginStep.Login;
        }
        else if (PostedCreatePassword is not null)
        {
            CreatePasswordInput = PostedCreatePassword;
            _step = LoginStep.CreatePassword;
        }
    }

    private static string NormalizeDni(string dni) =>
        string.Concat(dni.Where(c => !char.IsWhiteSpace(c) && c != '.' && c != '-'));

    private static string FormatDni(string dni) =>
        string.Join('.', new[] { Slice(dni, 0, 2), Slice(dni, 2, 3), Slice(dni, 5, 3) }.Where(part => part.Length > 0));

    private static string Slice(string value, int start, int length) =>
        start >= value.Length ? string.Empty : value.Substring(start, Math.Min(length, value.Length - start));

    private async Task HandleDni()
    {
        _errorMessage = null;

        try
        {
            var dni = NormalizeDni(DniInput.Dni);
            var result = await AuthApiClient.CheckDniAsync(dni);

            if (!result.IsSuccess)
            {
                _errorMessage = result.Error;
                return;
            }

            if (result.Access == DniAccess.HasPassword)
            {
                LoginInput = new LoginModel { Dni = dni };
                _step = LoginStep.Login;
            }
            else
            {
                CreatePasswordInput = new CreatePasswordModel { Dni = dni };
                _step = LoginStep.CreatePassword;
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage = "No fue posible conectar con la API.";
        }
    }

    private async Task HandleLogin()
    {
        _errorMessage = null;

        try
        {
            var result = await AuthApiClient.LoginAsync(LoginInput);

            if (!result.IsSuccess)
            {
                _errorMessage = result.Error;
                LoginInput.Password = string.Empty;
                return;
            }

            await AuthCookie.SignInAsync(HttpContext, result.Tokens!, result.User!);
            Navigation.NavigateTo(LoginRedirect.SanitizeReturnUrl(ReturnUrl));
        }
        catch (HttpRequestException)
        {
            _errorMessage = "No fue posible conectar con la API.";
            LoginInput.Password = string.Empty;
        }
    }

    private async Task HandleCreatePassword()
    {
        _errorMessage = null;

        try
        {
            var result = await AuthApiClient.CreatePasswordAsync(CreatePasswordInput.Dni, CreatePasswordInput);

            if (result.IsSuccess)
            {
                _step = LoginStep.Success;
            }
            else
            {
                _errorMessage = result.Error;
                CreatePasswordInput.Password = string.Empty;
                CreatePasswordInput.ConfirmPassword = string.Empty;
            }
        }
        catch (HttpRequestException)
        {
            _errorMessage = "No fue posible conectar con la API.";
            CreatePasswordInput.Password = string.Empty;
            CreatePasswordInput.ConfirmPassword = string.Empty;
        }
    }
}
