@page "/login"
@inject NavigationManager Navigation
@using instituto93.Web.Models;
@using instituto93.Web.Services
@inject AuthApiClient AuthApiClient

<PageTitle>Iniciar Sesión</PageTitle>

<main class="login-page">

    <section class="login-hero">
        <header class="institution">
            <img
                src="/images/logo.png"
                alt="Logo del Instituto Superior de Formación Técnica N° 93" />

            <div>
                <strong>
                    Instituto Superior de Formación Técnica N° 93
                </strong>

                <span>Portal académico</span>
            </div>
        </header>

        <div class="login-hero-content">
            <h1>
                Bienvenido/a al portal<br />
                web del instituto
            </h1>

            <p>
                Accedé a información, trámites y herramientas
                para acompañar tu experiencia institucional.
            </p>
        </div>
    </section>

    <section class="login-content">

        <article class="login-card">

            <header>
                <h2>Ingresá al portal</h2>

                <p>
                    Usá tus credenciales institucionales para continuar.
                </p>
            </header>
            @* Es lo mismo que un <form>, pero con validación de datos y binding de modelos. *@
            <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudTextField
                Label="D.N.I o correo electrónico"
                @bind-Value="_loginModel.EmailOrDni"
                Variant="Variant.Outlined"
                FullWidth />

            <MudTextField
                Label="Contraseña"
                @bind-Value="_loginModel.Password"
                InputType="InputType.Password"
                Variant="Variant.Outlined"
                FullWidth />

            <MudButton
                ButtonType="ButtonType.Submit"
                Variant="Variant.Filled"
                Color="Color.Primary"
                Disabled="_isSubmitting"
                FullWidth>
                @(_isSubmitting ? "Ingresando..." : "Ingresar")
            </MudButton>

        </EditForm>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <MudAlert Severity="Severity.Success" Class="mt-4">@_successMessage</MudAlert>
        }

        </article>

    </section>

</main>

@code {
    private LoginModel _loginModel = new LoginModel();
    private bool _isSubmitting;
    private string? _errorMessage;
    private string? _successMessage;
    
    private async Task HandleLogin()
{
    _isSubmitting = true;
    _errorMessage = null;
    _successMessage = null;

    try
    {
        var result = await AuthApiClient.LoginAsync(_loginModel);

        if (result is null)
        {
            _errorMessage = "La API devolvió una respuesta inválida.";
            return;
        }

        if (result.IsSuccess)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            _errorMessage = result.Error;
        }
    }
    catch (HttpRequestException)
    {
        _errorMessage = "No fue posible conectar con la API.";
    }
    finally
    {
        _isSubmitting = false;
    }
}
}
