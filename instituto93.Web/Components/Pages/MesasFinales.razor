@page "/mesas-finales"

<PageTitle>Listado de Mesas Finales</PageTitle>

<div class="mesas-finales-page">
    <MudAppBar Class="mesas-header"
               Fixed="false"
               Color="Color.Primary"
               Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Abrir menú" />

        <MudAvatar Class="mesas-header-logo" Size="Size.Medium" Color="Color.Surface">
            <MudImage Src="/images/logo.png"
                      Alt="Logo del Instituto Superior de Formación Docente y Técnica N°93" />
        </MudAvatar>

        <span class="mesas-header-title">
            Instituto Superior de Formación Docente y<br />
            Tecnica N°93
        </span>

        <div class="mesas-header-user">
            <MudAvatar Class="mesas-header-user-avatar" Size="Size.Medium" Variant="Variant.Filled" Color="Color.Surface">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Primary" />
            </MudAvatar>

            <span class="mesas-header-user-info">
                <span class="mesas-header-user-label">Estudiante:</span>
                <span class="mesas-header-user-name">Nombre</span>
            </span>
        </div>
    </MudAppBar>

    <div class="mesas-finales-container">
        <MudText Typo="Typo.h5" Class="mesas-titulo">
            Listado de Mesas Finales - Inscripción 2026
        </MudText>

        <div class="mesas-filtros">
            <MudTextField T="string"
                          Class="mesas-buscador"
                          Placeholder="Buscar materia, docente, año...."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined" />

            <div class="mesas-select mesas-select-turno">
                <span class="mesas-select-etiqueta">Turno:</span>

                <MudSelect T="string"
                           Placeholder="Nov/Dic"
                           Variant="Variant.Outlined" />
            </div>

            <div class="mesas-select">
                <MudIcon Class="mesas-select-icono"
                         Icon="@Icons.Material.Filled.School" />

                <MudSelect T="string"
                           Placeholder="Carrera"
                           Variant="Variant.Outlined" />
            </div>

            <div class="mesas-select">
                <MudIcon Class="mesas-select-icono"
                         Icon="@Icons.Material.Filled.CalendarMonth" />

                <MudSelect T="string"
                           Class="mesas-select-anio"
                           @bind-Value="_anioAcademico"
                           Placeholder="Año academico"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value="@("1°")">1°</MudSelectItem>
                    <MudSelectItem Value="@("2°")">2°</MudSelectItem>
                    <MudSelectItem Value="@("3°")">3°</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        <div class="mesas-bloque-tabla">
            <div class="mesas-tab">Carrera :</div>

            <div class="mesas-card">
                <section class="mesas-anio">
                    <MudText Typo="Typo.h6" Class="mesas-anio-titulo">1° AÑO</MudText>

                    <div class="mesas-tabla-scroll">
                        <MudSimpleTable Class="mesas-tabla">
                            <thead>
                                <tr>
                                    <th>Asiste</th>
                                    <th>Materia</th>
                                    <th>Docente</th>
                                    <th>Fecha y Hora</th>
                                    <th>Sede</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </MudSimpleTable>
                    </div>
                </section>

                <section class="mesas-anio">
                    <MudText Typo="Typo.h6" Class="mesas-anio-titulo">2° AÑO</MudText>

                    <div class="mesas-tabla-scroll">
                        <MudSimpleTable Class="mesas-tabla">
                            <thead>
                                <tr>
                                    <th>Asiste</th>
                                    <th>Materia</th>
                                    <th>Docente</th>
                                    <th>Fecha y Hora</th>
                                    <th>Sede</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </MudSimpleTable>
                    </div>
                </section>
            </div>

            <div class="mesas-acciones">
                <MudButton Class="mesas-btn-anotarse"
                           Variant="Variant.Filled"
                           Color="Color.Primary">
                    Anotarse
                </MudButton>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _anioAcademico;
}
