@using instituto93.Web.Services
@inject AccountApiClient AccountApiClient

<div class="app-header-wrapper">
    <MudAppBar Class="app-header"
            Fixed="false"
            Color="Color.Primary"
            Elevation="0">
        <MudIconButton Class="app-header-menu-btn"
                    Icon="@Icons.Material.Filled.Menu"
                    Color="Color.Inherit"
                    Edge="Edge.Start"
                    Size="Size.Small"
                    OnClick="AbrirMenu"
                    aria-label="Abrir menú" />

        <a href="/" class="app-header-home" aria-label="Ir al inicio">
            <MudAvatar Class="app-header-logo" Size="Size.Medium" Color="Color.Surface">
                <MudImage Src="/images/logo.png"
                        Alt="Logo del Instituto Superior de Formación Docente y Técnica N°93" />
            </MudAvatar>

            <span class="app-header-title">
                Instituto Superior de Formación Docente y<br />
                Tecnica N°93
            </span>
        </a>

        <div class="app-header-user">
            <MudBadge Dot="true" Color="Color.Surface" Overlap="true">
                <MudIconButton Icon="@Icons.Material.Outlined.NotificationsNone"
                            Color="Color.Inherit"
                            Size="Size.Small"
                            aria-label="Notificaciones" />
            </MudBadge>

            @* La cookie de sesión (HttpOnly) solo se borra desde una request HTTP: el menú
            vive dentro de este form (display:contents, invisible para el layout) y el
            item "Cerrar sesión" lo envía vía js/app-header.js → POST /account/logout,
            que revoca el refresh token, borra la cookie y redirige al login. *@
            <form method="post" action="/account/logout" id="app-header-logout-form" class="app-header-logout-form">
                <AntiforgeryToken />

                <MudMenu Class="app-header-user-menu"
                        PopoverClass="app-tab-menu-popover"
                        AnchorOrigin="Origin.BottomRight"
                        TransformOrigin="Origin.TopRight"
                        ActivationEvent="MouseEvent.LeftClick">
                    <ActivatorContent>
                        <span class="app-header-user-block" @onclick="context.ToggleAsync">
                            <span class="app-header-user-name">@_userName</span>

                            <MudAvatar Class="app-header-user-avatar" Size="Size.Medium" Variant="Variant.Filled" Color="Color.Surface">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Large" Color="Color.Primary" />
                            </MudAvatar>

                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Class="app-header-user-chevron" />
                        </span>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="CerrarSesion">
                            Cerrar sesión
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </form>
        </div>
    </MudAppBar>

    @if (_menuAbierto)
    {
        <div class="app-mobile-overlay" @onclick="CerrarMenu"></div>
    }

    <aside class="app-mobile-menu @(_menuAbierto ? "abierto" : null)" aria-label="Menú principal">
        <div class="app-mobile-menu-cabecera">
            <span>Menú</span>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                        Color="Color.Inherit"
                        Size="Size.Small"
                        OnClick="CerrarMenu"
                        aria-label="Cerrar menú" />
        </div>

        <MudNavMenu Class="app-mobile-nav" Color="Color.Primary">
            <MudNavLink Href="/" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Home"
                        OnClick="CerrarMenu">Inicio</MudNavLink>

            <MudNavGroup Title="Instituto">
                <MudNavLink OnClick="CerrarMenu">Nuestras Carreras</MudNavLink>
                <MudNavLink OnClick="CerrarMenu">Perfil del Egresado</MudNavLink>
                <MudNavLink OnClick="CerrarMenu">Datos Institucionales</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Calendario">
                <MudNavLink Href="https://isfdyt93-bue.infd.edu.ar/sitio/wp-content/uploads/2026/06/Calendario-2026-ISFT93_v2.pdf"
                            Target="_blank"
                            OnClick="CerrarMenu">Calendario Academico 2026</MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Alumnos">
                <MudNavLink OnClick="CerrarMenu">Formularios</MudNavLink>
                <MudNavLink OnClick="CerrarMenu">Becas PROGRESAR</MudNavLink>
                <MudNavLink OnClick="CerrarMenu">Horarios Ciclo Lectivo 2026</MudNavLink>
            </MudNavGroup>

            <AuthorizeView Roles="Docente" Context="auth">
                <MudNavGroup Title="Docentes">
                    <MudNavLink Href="/docentes/materias" OnClick="CerrarMenu">Mis materias</MudNavLink>
                    <MudNavLink Href="/docentes/mesas-finales" OnClick="CerrarMenu">Mesas finales</MudNavLink>
                    <MudNavLink Href="/docentes/normativa" OnClick="CerrarMenu">Normativa</MudNavLink>
                    <MudNavLink Href="/docentes/formularios" OnClick="CerrarMenu">Formularios</MudNavLink>
                    <MudNavLink Href="/docentes/calendario" OnClick="CerrarMenu">Calendario</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
        </MudNavMenu>
    </aside>
</div>

@code {
    private bool _menuAbierto;

    private void AbrirMenu() => _menuAbierto = true;

    private void CerrarMenu() => _menuAbierto = false;

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    private string _userName = "Estudiante";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AccountApiClient.GetCurrentUserAsync();
            if (user is not null)
            {
                _userName = user.Nombre;
            }
        }
        catch
        {
            // Sin sesión o sin API: se muestra el nombre por defecto.
        }
    }

    private Task CerrarSesion(MouseEventArgs _) =>
        Js.InvokeVoidAsync("appHeader.submitLogout").AsTask();
}
